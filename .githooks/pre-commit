#!/usr/bin/env bash
# Red de seguridad de publicación: bloquea lo privado antes de que llegue a un commit.
# Activar una vez por clon:  git config core.hooksPath .githooks
# Saltar (solo si estás seguro):  git commit --no-verify
set -u
fail=0

# 1) Nada de la ruta privada puede entrar.
if git diff --cached --name-only | grep -E '^(mi-ruta|_privado)/' >/dev/null; then
  echo "❌ Hay archivos de mi-ruta/ o _privado/ en el commit (son privados)."; fail=1
fi

# 2) Patrones de secretos y datos personales en las líneas añadidas.
added=$(git diff --cached -U0 --no-color -- . ':!.githooks' ':!.claude' | grep -E '^\+[^+]' || true)
check() { # descripción, regex
  if printf '%s\n' "$added" | grep -E -i -- "$2" >/dev/null; then
    echo "❌ Posible dato privado: $1"; printf '%s\n' "$added" | grep -E -i -n -- "$2" | head -3; fail=1
  fi
}
check "clave de API / token"        'AIza[0-9A-Za-z_-]{30,}|sk-[A-Za-z0-9]{20,}|gh[pous]_[A-Za-z0-9]{30,}|AKIA[0-9A-Z]{16}'
check "clave privada"               'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY'
check "correo electrónico"          '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.(com|net|org|pe|ec|co|io)\b'
check "honorarios / sueldo con cifra" '(honorarios|salario|sueldo|oferta)[^|]{0,40}(USD|US\$|\$) ?[0-9][0-9.,]{2,}|(USD|US\$) ?[0-9][0-9.,]{3,} ?(mensual|/mes|bruto)'

# 3) Lista privada de palabras (nombres, clientes). Vive en _privado/ y NO se sube.
if [ -f _privado/denylist.txt ]; then
  while IFS= read -r w; do
    [ -z "$w" ] && continue; case "$w" in \#*) continue;; esac
    if printf '%s\n' "$added" | grep -F -i -- "$w" >/dev/null; then
      echo "❌ Aparece una palabra de tu lista privada (_privado/denylist.txt)."; fail=1
    fi
  done < _privado/denylist.txt
fi

[ "$fail" -eq 0 ] || { echo; echo "Commit detenido. Revisa con el agente revisor-publicacion o corrige."; exit 1; }
